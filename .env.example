# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Modelo de imagen (Recraft V4.1 Flash V2, variante gratuita)
MEIK_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

# Salida por defecto: webp | jpeg | png | avif  (+ calidad 40-100)
MEIK_OUTPUT_FORMAT=webp
MEIK_OUTPUT_QUALITY=82

# Carpeta donde se guardan los originales en local. Usa "off" para no escribir en disco.
MEIK_IMAGE_DIR=output

# Presupuesto de caracteres para la imagen inline devuelta al cliente (~150k es el límite de Claude).
MEIK_INLINE_MAX_CHARS=120000

# Timeout y reintentos frente a OpenRouter
MEIK_IMAGE_TIMEOUT_SECONDS=180
MEIK_IMAGE_MAX_RETRIES=2

# Cabeceras de atribución enviadas a OpenRouter
MEIK_APP_URL=https://meiklabs.com
MEIK_APP_NAME=Meik Labs Image MCP

# Unsplash (opcional): fotografía real en vez de ilustración
# https://unsplash.com/oauth/applications -> Access Key
UNSPLASH_ACCESS_KEY=

LOG_LEVEL=INFO

# ---------------------------------------------------------------- media server
# Publicación en cPanel / hosting compartido. Modo: off | cpanel | sftp | ftp | ftps
MEIK_MEDIA_MODE=cpanel
# Modo cpanel: token de cPanel (Security -> Manage API Tokens). El host se deriva
# de MEIK_MEDIA_BASE_URL si no defines MEIK_MEDIA_HOST.
MEIK_MEDIA_CPANEL_TOKEN=tu-token
MEIK_MEDIA_USER=usuario_cpanel
# Carpeta remota absoluta y su URL pública equivalente
MEIK_MEDIA_REMOTE_DIR=/home2/usuario/public_html/img/blog/
MEIK_MEDIA_BASE_URL=https://static.ejemplo.com/img/blog
# Subcarpeta por día (YYYY-MM-DD). Para el blog va en false: /img/blog/<slug>.webp
MEIK_MEDIA_SUBDIR_BY_DATE=false
# Nombres: slug = estable (/img/blog/<slug>.webp) | unique = con hora y sufijo aleatorio
MEIK_MEDIA_NAMING=slug

# --- Alternativa SFTP/FTP (si el modo cpanel no está disponible) ---
# MEIK_MEDIA_HOST=sftp.ejemplo.com
# MEIK_MEDIA_PORT=22
# MEIK_MEDIA_PASSWORD=tu-clave
# MEIK_MEDIA_KEY_PATH=C:\ruta\a\clave_privada
