# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Modelo de imagen (Recraft V4.1 Flash V2, variante gratuita)
MEIK_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

# Salida por defecto: webp | jpeg | png | avif  (+ calidad 40-100)
MEIK_OUTPUT_FORMAT=webp
MEIK_OUTPUT_QUALITY=82

# Carpeta donde se guardan los originales en local. Usa "off" para no escribir en disco.
MEIK_IMAGE_DIR=output

# Presupuesto de caracteres para la imagen inline devuelta al cliente (~150k es el límite de Claude).
MEIK_INLINE_MAX_CHARS=120000

# Timeout y reintentos frente a OpenRouter
MEIK_IMAGE_TIMEOUT_SECONDS=180
MEIK_IMAGE_MAX_RETRIES=2

# Cabeceras de atribución enviadas a OpenRouter
MEIK_APP_URL=https://meiklabs.com
MEIK_APP_NAME=Meik Labs Image MCP

LOG_LEVEL=INFO

# ---------------------------------------------------------------- media server
# Publicación en cPanel / hosting compartido. Modo: off | sftp | ftp | ftps
MEIK_MEDIA_MODE=sftp
MEIK_MEDIA_HOST=sftp.meiklabs.com
MEIK_MEDIA_PORT=22
MEIK_MEDIA_USER=usuario_cpanel
MEIK_MEDIA_PASSWORD=tu-clave
# Carpeta remota absoluta (o relativa al home del usuario SSH)
MEIK_MEDIA_REMOTE_DIR=/home2/usuario/public_html/assets/blog/
# URL pública que corresponde a esa carpeta
MEIK_MEDIA_BASE_URL=https://meiklabs.com/assets/blog
# Subcarpeta por día (YYYY-MM-DD) dentro de REMOTE_DIR
MEIK_MEDIA_SUBDIR_BY_DATE=true
